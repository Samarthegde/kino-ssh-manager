{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kino SSH Manager",
  "version": "0.9.1",
  "identifier": "com.kino.ssh-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kino SSH Manager",
        "width": 1200,
        "height": 750,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Samarthegde/kino-ssh-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MTdGM0Q5RDREOUM0RTEKUldUaHhOblUyZk1YNUxCSHFpOUtmMUNibFRtRU1Cb0JremlYaXJlR29JekhDa2EvT2ZyQ2JmNjQK"
    }
  }
}
